#!/usr/bin/env bash
#MISE description="Install and configure everything SMarT needs on this Mac. Safe to re-run."
#MISE raw=true
#MISE quiet=true
set -euo pipefail

local_hostname="service.local.smart.mcga.uk"
containers_conf="${XDG_CONFIG_HOME:-$HOME/.config}/containers/containers.conf"
rosetta_ready=true
to_do=()

print_step_heading() {
  printf '\n==> %s\n' "$1"
}

add_to_do() {
  to_do+=("$1")
}

aws_cli_without_profile_override() {
  env -u AWS_PROFILE mise exec -- aws "$@"
}

is_apple_silicon() {
  [[ $(uname -m) == arm64 ]]
}

rosetta_is_installed() {
  arch -x86_64 /usr/bin/true 2>/dev/null
}

podman_config_has_rosetta_enabled() {
  [[ -f $containers_conf ]] && grep -Eq '^[[:space:]]*rosetta[[:space:]]*=[[:space:]]*true' "$containers_conf"
}

podman_config_has_machine_section() {
  [[ -f $containers_conf ]] && grep -Eq '^[[:space:]]*\[machine\]' "$containers_conf"
}

podman_machine_exists() {
  podman machine inspect >/dev/null 2>&1
}

podman_machine_is_running() {
  [[ $(podman machine inspect --format '{{.State}}') == running ]]
}

podman_machine_has_rosetta() {
  [[ $(podman machine inspect --format '{{.Rosetta}}') == true ]]
}

aws_profile_exists() {
  aws_cli_without_profile_override configure list-profiles 2>/dev/null | grep -qx "$AWS_PROFILE"
}

hosts_file_points_local_hostname_to_localhost() {
  awk -v host="$local_hostname" '
    $1 == "127.0.0.1" { for (i = 2; i <= NF && $i !~ /^#/; i++) if ($i == host) found = 1 }
    END { exit !found }' /etc/hosts
}

check_env_file_is_filled_in() {
  print_step_heading ".env"
  if [[ ! -f .env ]]; then
    echo "Missing."
    add_to_do "Create .env: copy .env.example to .env, then fill it in from \"SMarT-UI .env contents\" in the SMarT 1Password vault (click Edit before copying, so the # characters come too)."
  elif cmp -s .env .env.example; then
    echo "Not filled in yet."
    add_to_do "Fill in .env from \"SMarT-UI .env contents\" in the SMarT 1Password vault (click Edit before copying, so the # characters come too)."
  else
    echo "Filled in."
  fi
}

install_podman_and_docker_compose() {
  print_step_heading "Podman and Docker Compose"
  if brew bundle check --file=Brewfile >/dev/null 2>&1; then
    echo "Already installed."
  else
    brew bundle install --file=Brewfile
  fi
}

warn_if_docker_desktop_is_installed() {
  if [[ -d /Applications/Docker.app ]]; then
    add_to_do "Docker Desktop is installed. There is potential for conflict with Podman."
  fi
}

check_rosetta_is_installed() {
  print_step_heading "Rosetta"
  if rosetta_is_installed; then
    echo "Already installed."
  else
    echo "Not installed."
    rosetta_ready=false
    add_to_do "Install Rosetta with: softwareupdate --install-rosetta --agree-to-license, then re-run mise run setup to create the Podman machine."
  fi
}

enable_rosetta_in_podman_config() {
  print_step_heading "Rosetta in Podman's config ($containers_conf)"
  if podman_config_has_rosetta_enabled; then
    echo "Already set."
  elif podman_config_has_machine_section; then
    rosetta_ready=false
    add_to_do "Add 'rosetta = true' under [machine] in $containers_conf, then re-run mise run setup to create the Podman machine."
  else
    mkdir -p "$(dirname "$containers_conf")"
    if [[ -s $containers_conf ]]; then
      printf '\n' >>"$containers_conf"
    fi
    printf '[machine]\nrosetta = true\n' >>"$containers_conf"
    echo "Added rosetta = true."
  fi
}

create_and_start_podman_machine() {
  print_step_heading "Podman machine"
  if podman_machine_exists; then
    echo "Already created."
    if is_apple_silicon && ! podman_machine_has_rosetta; then
      add_to_do "Your Podman machine was created without Rosetta. Recreate it with: podman machine stop && podman machine rm, then re-run mise run setup. This deletes its pulled images and container data."
    fi
  elif $rosetta_ready; then
    podman machine init --rootful --cpus 4 --memory 8192
  else
    echo "Skipped until Rosetta is ready, so the machine isn't created without it."
  fi
  if podman_machine_exists && ! podman_machine_is_running; then
    podman machine start
  fi
}

install_tools_from_mise_toml() {
  print_step_heading "Node, the AWS CLI, Terraform and cosign"
  mise install
}

ask_for_smart_dev_account_number() {
  account_id=""
  [[ -t 0 ]] || return 0
  echo "Find the smart-dev account number in the AWS access portal (https://mcaconsole.awsapps.com/start/)."
  while read -r -p "smart-dev account number (12 digits, Enter to skip): " account_id; do
    [[ -z $account_id || $account_id =~ ^[0-9]{12}$ ]] && break
    echo "That isn't a 12-digit number."
  done
}

write_aws_profile_for_account() {
  local account_id=$1
  aws_cli_without_profile_override configure set sso_start_url "https://mcaconsole.awsapps.com/start/#" --profile "$AWS_PROFILE"
  aws_cli_without_profile_override configure set sso_region eu-west-2 --profile "$AWS_PROFILE"
  aws_cli_without_profile_override configure set sso_account_id "$account_id" --profile "$AWS_PROFILE"
  aws_cli_without_profile_override configure set sso_role_name SMarTSupportAccess --profile "$AWS_PROFILE"
  aws_cli_without_profile_override configure set region eu-west-2 --profile "$AWS_PROFILE"
  aws_cli_without_profile_override configure set output json --profile "$AWS_PROFILE"
}

add_aws_profile_if_missing() {
  print_step_heading "AWS profile '$AWS_PROFILE' in ~/.aws/config"
  if aws_profile_exists; then
    echo "Already set up."
    return
  fi
  ask_for_smart_dev_account_number
  if [[ -n $account_id ]]; then
    write_aws_profile_for_account "$account_id"
    echo "Added the profile."
  else
    add_to_do "Add the '$AWS_PROFILE' profile to ~/.aws/config (see .mise/README.md: Doing the setup by hand)."
  fi
}

check_hosts_file_has_local_hostname() {
  print_step_heading "$local_hostname in /etc/hosts"
  if hosts_file_points_local_hostname_to_localhost; then
    echo "Already there."
  else
    echo "Not there."
    add_to_do "Add '127.0.0.1 $local_hostname' to /etc/hosts, for example with: sudo nano /etc/hosts"
  fi
}

print_what_is_left_to_do() {
  echo
  if ((${#to_do[@]})); then
    echo "Setup finished. Still to do:"
    printf '  - %s\n' "${to_do[@]}"
    echo
    echo "Then run: mise run dev"
  else
    echo "Setup finished. Run: mise run dev"
  fi
}

check_env_file_is_filled_in
install_podman_and_docker_compose
warn_if_docker_desktop_is_installed
if is_apple_silicon; then
  check_rosetta_is_installed
  enable_rosetta_in_podman_config
fi
create_and_start_podman_machine
install_tools_from_mise_toml
add_aws_profile_if_missing
check_hosts_file_has_local_hostname
print_what_is_left_to_do
