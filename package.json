{
    "name": "@mca/smart-ui",
    "version": "0.2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mcga-gov-uk/smart-ui.git"
    },
    "author": "Catapult CX",
    "description": "SMarT UI",
    "scripts": {
        "clean": "rm -rf reports && rm -rf wdio-output",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --forceExit",
        "test-jest": "jest --ci --coverage --forceExit --runInBand --detectOpenHandles",
        "test:bdd": "cucumber-js",
        "test-noc": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci  --silent false --coverage=false --forceExit",
        "start": "gulp default && nodemon ./src/bin/www",
        "start-mon": "nodemon ./src/bin/www",
        "poststart": "npm prune --production",
        "standard": "standard src/**/*.js",
        "wdio-debug": "wdio run test/wdio-chrome.conf.cjs --suite debug",
        "wdio-chrome": "wdio run test/wdio-chrome.conf.cjs",
        "wdio-headless": "wdio run test/wdio-headless.conf.cjs",
        "ca:login": "npm config --location=project set '//mcga-009543623063.d.codeartifact.eu-west-2.amazonaws.com/npm/mcga-npm/:_authToken' \"$(aws codeartifact get-authorization-token --domain mcga --domain-owner 009543623063 --query authorizationToken --output text)\"",
        "ca:set-reg": "npm config --location=project set registry https://mcga-009543623063.d.codeartifact.eu-west-2.amazonaws.com/npm/mcga-npm/",
        "ca:setup": "npm run ca:set-reg && npm run ca:login",
        "comments-db": "docker-compose stop smart-comments-db - d && docker-compose rm smart-comments-db -f && docker-compose up smart-comments-db -d",
        "api-db": "docker-compose stop smart-api-db - d && docker-compose rm smart-api-db -f && docker-compose up smart-api-db -d",
        "api-db-restart": "npm run db && docker-compose restart smart-api - d"
    },
    "standard": {
        "ignore": [
            "src/public/",
            "src/bin/",
            "test/"
        ]
    },
    "dependencies": {
        "@mca/common-logger": "^2.0.2",
        "@ministryofjustice/frontend": "^1.8.1",
        "@mswjs/interceptors": "0.26.5",
        "@okta/oidc-middleware": "^5.2.1",
        "@okta/okta-sdk-nodejs": "6.6.0",
        "@types/node": "^20.11.19",
        "accessible-autocomplete": "^2.0.4",
        "aws-xray-sdk": "^3.5.3",
        "btoa": "^1.2.1",
        "compression": "^1.7.4",
        "connect-redis": "^6.1.3",
        "convict": "^6.2.4",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csurf": "^1.11.0",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "express-form-data": "^2.0.23",
        "express-session": "^1.18.0",
        "express-validator": "^6.15.0",
        "govuk_frontend_toolkit": "^9.0.1",
        "govuk-frontend": "^4.8.0",
        "helmet": "^6.0.1",
        "http-errors": "^2.0.0",
        "jquery": "^3.7.1",
        "jwt-decode": "^3.1.2",
        "moment": "^2.30.1",
        "moment-range": "^4.0.2",
        "moment-timezone": "^0.5.45",
        "njwt": "^2.0.0",
        "nocache": "^3.0.4",
        "nunjucks": "^3.2.4",
        "pretty-error": "^4.0.0",
        "redis": "^4.6.13",
        "serve-favicon": "^2.5.0",
        "superagent": "^10.0.5",
        "url-join": "^5.0.0",
        "useful-nunjucks-filters": "^0.1.3"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^10.3.1",
        "@wdio/cli": "^7.24.1",
        "@wdio/devtools-service": "^7.24.1",
        "@wdio/junit-reporter": "^7.24.1",
        "@wdio/local-runner": "^7.24.1",
        "@wdio/mocha-framework": "^7.24.1",
        "@wdio/spec-reporter": "^7.24.1",
        "chromedriver": "^126.0.4",
        "cross-env": "^7.0.3",
        "decache": "^4.6.2",
        "deepmerge": "^4.3.1",
        "del": "^7.0.0",
        "eslint": "^8.56.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^27.9.0",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^6.1.1",
        "eslint-plugin-webdriverio": "^1.0.1",
        "esm": "^3.2.25",
        "express-request-mock": "^3.1.0",
        "govuk-elements-sass": "^3.1.3",
        "gulp": "^4.0.2",
        "gulp-cli": "^2.3.0",
        "gulp-nodemon": "^2.5.0",
        "gulp-nunjucks": "^5.1.0",
        "gulp-sass": "^5.1.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.7",
        "jest-junit": "^16.0.0",
        "jest-sonar": "^0.2.16",
        "node-sass": "^9.0.0",
        "nodemon": "^3.0.3",
        "npm-check-updates": "^16.14.18",
        "pg": "^8.11.3",
        "sass": "^1.70.0",
        "supertest": "^7.0.0",
        "wdio-chromedriver-service": "^8.1.1",
        "wdio-html-nice-reporter": "^7.9.1"
    },
    "nodemonConfig": {
        "watch": [
            ".env",
            "src",
            "public"
        ],
        "ext": "js,yaml,html,njk,mjs"
    }
}
