{
    "name": "@mca/smart-ui",
    "version": "0.2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mcagov/smart-ui.git"
    },
    "author": "Catapult CX",
    "description": "SMarT UI",
    "scripts": {
        "clear-test-outputs": "rm -rf reports && rm -rf wdio-output",
        "lint": "standard src/**/*.js",
        "start": "gulp default && nodemon ./src/bin/www",
        "test": "NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --forceExit",
        "test-without-coverage": "npm run test -- --coverage=false",
        "test:bdd": "cucumber-js",
        "ca:setup": "node scripts/setup-codeartifact-npm-registry.js",
        "test:wdio-chrome": "wdio run test/wdio-chrome.conf.js",
        "test:wdio-debug": "wdio run test/wdio-chrome.conf.js --suite debug",
        "test:wdio-headless": "wdio run test/wdio-headless.conf.js"
    },
    "standard": {
        "ignore": [
            "src/public/",
            "src/bin/",
            "test/"
        ]
    },
    "dependencies": {
        "@mca/common-logger": "^2.0.4",
        "@ministryofjustice/frontend": "^8.0.0",
        "@mswjs/interceptors": "0.39.5",
        "@okta/oidc-middleware": "^5.5.0",
        "@okta/okta-sdk-nodejs": "7.3.0",
        "@types/node": "^22.0.0",
        "accessible-autocomplete": "^2.0.4",
        "aws-xray-sdk": "^3.10.3",
        "btoa": "^1.2.1",
        "compression": "^1.8.1",
        "connect-redis": "^6.1.3",
        "convict": "^6.2.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "csurf": "^1.11.0",
        "dotenv": "^16.6.1",
        "expect": "^29.7.0",
        "express": "^4.21.2",
        "express-form-data": "^3.0.1",
        "express-session": "^1.18.2",
        "express-validator": "^6.15.0",
        "govuk-frontend": "^5.14.0",
        "helmet": "^6.0.1",
        "http-errors": "^2.0.0",
        "jquery": "^3.7.1",
        "jwt-decode": "^3.1.2",
        "moment": "^2.30.1",
        "moment-range": "^4.0.2",
        "moment-timezone": "^0.6.0",
        "njwt": "^2.0.1",
        "nocache": "^3.0.4",
        "nunjucks": "^3.2.4",
        "pretty-error": "^4.0.0",
        "redis": "^4.7.1",
        "serve-favicon": "^2.5.1",
        "superagent": "^10.2.3",
        "url-join": "^5.0.0"
    },
    "devDependencies": {
        "@cucumber/cucumber": "^10.9.0",
        "@jest/globals": "^30.0.5",
        "@wdio/cli": "^9.23.0",
        "@wdio/devtools-service": "^10.1.0",
        "@wdio/globals": "9.27.2 ",
        "@wdio/junit-reporter": "^9.21.0",
        "@wdio/local-runner": "^9.23.0",
        "@wdio/mocha-framework": "^9.23.0",
        "@wdio/spec-reporter": "^9.20.0",
        "chromedriver": "^149.0.0",
        "decache": "^4.6.2",
        "deepmerge": "^4.3.1",
        "del": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^27.9.0",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^6.6.0",
        "eslint-plugin-webdriverio": "^1.0.1",
        "esm": "^3.2.25",
        "express-request-mock": "^3.1.0",
        "gulp": "^4.0.2",
        "gulp-cli": "^2.3.0",
        "gulp-nodemon": "^2.5.0",
        "gulp-nunjucks": "^5.1.0",
        "gulp-sass": "^5.1.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.7",
        "jest-junit": "^16.0.0",
        "jest-sonar": "^0.2.16",
        "nodemon": "^3.1.10",
        "npm-check-updates": "^22.2.3",
        "pg": "^8.16.3",
        "sass": "^1.89.2",
        "sinon": "^21.0.1",
        "supertest": "^7.1.4",
        "wdio-html-nice-reporter": "^8.1.7"
    },
    "overrides": {
        "@isaacs/brace-expansion": "^5.0.1",
        "cookie": "^0.7.0",
        "uuid": "^11.1.1",
        "tar": "^7.5.11",
        "braces": "^3.0.3",
        "micromatch": "^4.0.8",
        "semver": "^7.5.2",
        "serialize-javascript": "^7.0.5",
        "fast-xml-parser": "^5.5.6",
        "tar-fs": "^3.1.1",
        "ws": "^8.17.1",
        "tmp": "^0.2.3"
    },
    "nodemonConfig": {
        "watch": [
            ".env",
            "src",
            "public"
        ],
        "ext": "js,yaml,html,njk,mjs"
    }
}
