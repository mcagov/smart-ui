{% from "sub-navigation/macro.njk" import mojSubNavigation %}

{% set items = [
{
    text: 'Details',
    href: '/training-providers/' + params.trainingProvider.id,
    active: true if params.active == 'details' else false,
    attributes: { id: 'tp-details' }
},{
    text: 'Forecasts',
    href: '/training-providers/' + params.trainingProvider.id + '/forecasts',
    active: true if params.active == 'forecasts' else false,
    attributes: { id: 'tp-forecasts' }
}, {
    text: 'Claims',
    href: '/training-providers/' + params.trainingProvider.id + '/claims',
    active: true if params.active == 'claims' else false,
    attributes: { id: 'tp-claims' }
}, {
    text: 'Trainees',
    href: '/training-providers/' + params.trainingProvider.id + '/trainees',
    active: true if params.active == 'trainees' else false,
    attributes: { id: 'tp-trainees' }
}, {
    text: 'Enrolments',
    href: '/training-providers/' + params.trainingProvider.id + '/enrolments',
    active: true if params.active == 'enrolments' else false,
    attributes: { id: 'tp-enrolments' }
}, {
    text: 'Training',
    href: '/training-providers/' + params.trainingProvider.id + '/trainings?status=Active',
    active: true if params.active == 'training' else false,
    attributes: { id: 'tp-training' }
}, {
    text: 'Comments',
    href: '/training-providers/' + params.trainingProvider.id + '/comments?resolved=false',
