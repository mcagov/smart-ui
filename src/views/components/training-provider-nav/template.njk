    attributes: { id: 'tp-comments' }
}, {
    text: 'Attachments',
    href: '/training-providers/' + params.trainingProvider.id + '/attachments',
    active: true if params.active == 'attachments' else false,
    attributes: { id: 'tp-attachments' }
}, {
    text: 'Users',
    href: '/training-providers/' + params.trainingProvider.id + '/users',
    active: true if params.active == 'users' else false,
    attributes: { id: 'tp-users' }
}] %}

{{ mojSubNavigation({
    label: 'Training Provider Sub navigation',
    items: items
}) }}
