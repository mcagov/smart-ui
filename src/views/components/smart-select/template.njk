{% set items = [{ value: "-1", text: "-- status --" }] %}
{% for item in params.items %}
    {% set items = (items.push({ text: item.text, value: item.id}), items) %}
{% endfor %}

{% set id = params.id if params.id %}

{% from "select/macro.njk" import govukSelect %}

{{ govukSelect({
    id: id,
    name: params.name if params.name else id,
    label: {
        text: params.label.text if params.label.text,
        classes: params.label.classes if params.label.classes
    },
    items: items | selectValue(params.value)
}) }}
